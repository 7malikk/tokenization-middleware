{
  "name": "tokenization-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted tokenization middleware for permanent identifiers (BVN)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/main.js",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest",
    "test:int": "jest -c jest.int.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@prisma/client": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "prisma": "~6.19.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  },
  "overrides": {
    "fastify": "^5.12.5"
  }
}
