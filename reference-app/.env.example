# Copy to .env and adjust. Every setting comes from the environment.

# The reference app's own database (never the vault database).
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/reference?schema=public"

# Separate database for `npm run test:int`. Its name must end in "_test".
TEST_DATABASE_URL="postgresql://<user>:<password>@localhost:5432/reference_test?schema=public"

# HTTP port for this app.
PORT=8080

# The middleware, over HTTPS only, and the certificate to trust for it.
# Only this certificate is trusted: system CAs are not used.
MIDDLEWARE_URL=https://localhost:3000
MIDDLEWARE_CA_PATH=../certs/dev-cert.pem

# This app's API key for the middleware. Set exactly ONE of these.
# REFERENCE_API_KEY=tkm_...
# REFERENCE_API_KEY_FILE=/run/secrets/reference_api_key

LOG_LEVEL=info
