# Copy to .env and adjust. Every setting comes from the environment.

# Vault database used by the application and by `prisma migrate`.
DATABASE_URL="postgresql://vault:vault@localhost:5432/vault?schema=vault"

# Separate database for `npm run test:int`. The integration suite resets it,
# so never point this at a database you care about. Prisma creates it if missing.
TEST_DATABASE_URL="postgresql://vault:vault@localhost:5432/vault_test?schema=vault_test"

# HTTPS port for `npm run start`.
PORT=3000

# TLS is required: the server refuses to start without both paths.
# `npm run dev:certs` writes a self-signed pair to certs/ (gitignored).
TLS_CERT_PATH=certs/dev-cert.pem
TLS_KEY_PATH=certs/dev-key.pem

# Data types tokenize accepts (comma-separated). Each needs a known format.
ALLOWED_DATA_TYPES=BVN

# Fastify log level. Request and response bodies are never logged.
LOG_LEVEL=info

# Requests allowed per credential, per operation, per minute (default 600).
RATE_LIMIT_PER_MINUTE=600

# Master key file: every master key version, each wrapped under the KEK.
# Create it with `npm run key:init`. keys/ is gitignored.
MASTER_KEY_FILE=keys/master-keys.json

# Key-encryption key (KEK): 64 hex chars from `npm run key:generate-kek`.
# Set exactly ONE of these. MASTER_KEK_FILE (a path to a file holding the KEK,
# such as a Docker secret) keeps the KEK out of the environment and this file.
# MASTER_KEK=
# MASTER_KEK_FILE=/run/secrets/master_kek

# Host port for vault-db when using docker-compose.db-ports.yml (default 5433).
VAULT_DB_PORT=5433
